rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validTask() {
      let t = request.resource.data;
      return t.keys().hasAll(['title','description','dueDate','priority','completed','createdAt','updatedAt'])
        && t.keys().hasOnly(['title','description','dueDate','priority','completed','createdAt','updatedAt'])
        && t.title is string && t.title.size() > 0 && t.title.size() <= 120
        && t.description is string && t.description.size() <= 2000
        && t.dueDate is timestamp
        && t.priority in ['low','medium','high']
        && t.completed is bool
        && t.createdAt is timestamp && t.updatedAt == request.time;
    }
    match /users/{uid}/tasks/{taskId} {
      allow read, delete: if owner(uid);
      allow create: if owner(uid) && validTask() && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && validTask()
        && request.resource.data.createdAt == resource.data.createdAt;
    }
    // Everything else remains denied, including other users' tasks.
  }
}
